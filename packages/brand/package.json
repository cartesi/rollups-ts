{
    "name": "@cartesi/brand",
    "description": "Cartesi brand tokens, fonts and logo assets",
    "version": "0.0.0",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/cartesi/rollups-ts"
    },
    "dependencies": {
        "@fontsource/inter": "^5.3.0",
        "@fontsource/plus-jakarta-sans": "^5.3.0"
    },
    "devDependencies": {
        "@biomejs/biome": "catalog:",
        "@types/node": "catalog:",
        "tsdown": "catalog:",
        "typescript": "catalog:"
    },
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "require": "./dist/index.cjs"
            }
        },
        "./tokens": {
            "import": {
                "types": "./dist/tokens.d.ts",
                "import": "./dist/tokens.js"
            },
            "require": {
                "types": "./dist/tokens.d.cts",
                "require": "./dist/tokens.cjs"
            }
        },
        "./styles.css": "./styles/index.css",
        "./styles/tokens.css": "./styles/tokens.css",
        "./styles/fonts.css": "./styles/fonts.css",
        "./package.json": "./package.json"
    },
    "files": [
        "LICENSE",
        "NOTICE",
        "dist/**",
        "styles/**"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsdown",
        "check-types": "tsc --noEmit",
        "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
        "dev": "tsdown --watch",
        "lint": "biome check"
    }
}
