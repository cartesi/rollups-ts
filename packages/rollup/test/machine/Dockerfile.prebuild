# Cross-builds the linux-riscv64 prebuild, mirroring the CI prebuild-riscv64
# job (see .github/workflows/release.yaml). Build from the package root:
#
#   docker build --platform linux/amd64 -f test/machine/Dockerfile.prebuild \
#     --target export --output type=local,dest=prebuilds .

FROM node:22-bookworm AS build

# libcmt bundles the `cmio` ioctl ABI since machine-guest-tools 0.18.0
# (include/libcmt/ioctl.h), so the Cartesi Linux headers are no longer needed
# to cross-build it.
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc-riscv64-linux-gnu g++-riscv64-linux-gnu \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work
COPY . .

RUN make -C deps/machine-guest-tools/sys-utils/libcmt libcmt TOOLCHAIN_PREFIX=riscv64-linux-gnu-

# The devDependencies use pnpm's `catalog:` protocol, which npm cannot resolve,
# and none of them is needed to cross-compile the addon: drop them and install
# the runtime dependencies (node-addon-api supplies binding.gyp's include_dir)
# plus the prebuild toolchain.
RUN node -e "const fs=require('node:fs');const p=JSON.parse(fs.readFileSync('package.json','utf8'));delete p.devDependencies;delete p.scripts;fs.writeFileSync('package.json',JSON.stringify(p))" \
    && npm install --ignore-scripts \
    && npm install --ignore-scripts --no-save prebuildify@^6.0.1 node-gyp@^13.0.0

ENV CC=riscv64-linux-gnu-gcc \
    CXX=riscv64-linux-gnu-g++ \
    LIBCMT_LIB=/work/deps/machine-guest-tools/sys-utils/libcmt/build/riscv64/libcmt.a

RUN npx prebuildify --napi --strip --strip-bin riscv64-linux-gnu-strip --platform linux --arch riscv64

FROM scratch AS export
COPY --from=build /work/prebuilds /
