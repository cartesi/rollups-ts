{
    "name": "@cartesi/rollups-ts",
    "private": true,
    "scripts": {
        "build": "turbo run build",
        "changeset": "changeset",
        "check-types": "turbo run check-types",
        "clean": "turbo run clean",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
