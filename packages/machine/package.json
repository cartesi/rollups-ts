{
    "name": "@cartesi/machine",
    "description": "Node.js bindings for the Cartesi Machine emulator",
    "version": "1.0.0-alpha.1",
    "keywords": [
        "cartesi",
        "cartesi-machine",
        "emulator",
        "bindings"
    ],
    "license": "Apache-2.0",
    "author": "Cartesi",
    "repository": {
        "type": "git",
        "url": "https://github.com/cartesi/rollups-ts"
    },
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "browser": {
                "types": "./dist/browser.d.ts",
                "default": "./dist/browser.js"
            },
            "import": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "require": "./dist/index.cjs"
            }
        },
        "./wasm": {
            "types": "./dist/browser.d.ts",
            "import": "./dist/browser.js"
        },
        "./package.json": "./package.json",
        "./worker": {
            "types": "./dist/browser/worker.d.ts",
            "import": "./dist/browser/worker.js"
        },
        "./jsonrpc": {
            "types": "./dist/jsonrpc/client.d.ts",
            "import": "./dist/jsonrpc/client.js",
            "require": "./dist/jsonrpc/client.cjs"
        }
    },
    "files": [
        "LICENSE",
        "NOTICE",
        "binding.gyp",
        "dist/**",
        "native/addon.cc",
        "native/slirp-forward.cc",
        "scripts/find-cartesi.cjs",
        "scripts/install.cjs"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsdown && node scripts/copy-wasm.mjs",
        "build:native": "node-gyp rebuild",
        "build:wasm": "node scripts/build-wasm.mjs",
        "check-types": "tsc --noEmit",
        "clean": "rm -rf .turbo node_modules dist build",
        "dev": "tsdown --watch",
        "install": "node scripts/install.cjs",
        "lint": "biome check",
        "package:platform": "node scripts/package-platform.mjs",
        "test": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:run": "vitest run",
        "test:wasm": "vitest run --config vitest.wasm.config.ts"
    },
    "dependencies": {
        "node-addon-api": "^8.3.0",
        "node-gyp-build": "^4.8.4"
    },
    "devDependencies": {
        "@biomejs/biome": "catalog:",
        "@types/node": "catalog:",
        "@vitest/coverage-v8": "^4.1.10",
        "node-gyp": "^13.0.0",
        "tsdown": "catalog:",
        "typescript": "catalog:",
        "viem": "catalog:",
        "vitest": "^4.1.10"
    },
    "engines": {
        "node": ">=22"
    },
    "binary": {
        "napi_versions": [
            8
        ]
    }
}
