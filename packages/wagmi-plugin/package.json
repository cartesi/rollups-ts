{
    "name": "@cartesi/wagmi-plugin",
    "description": "wagmi CLI plugin for Cartesi Rollups contracts",
    "version": "1.0.0-alpha.1",
    "repository": {
        "type": "git",
        "url": "https://github.com/cartesi/rollups-ts"
    },
    "dependencies": {
        "abitype": "^1.2.4",
        "modern-tar": "^0.7.6"
    },
    "peerDependencies": {
        "@wagmi/cli": "^2.10.0",
        "viem": "^2.0.0"
    },
    "devDependencies": {
        "@biomejs/biome": "catalog:",
        "@types/node": "catalog:",
        "@wagmi/cli": "^2.10.0",
        "npm-run-all": "^4.1.5",
        "tsdown": "catalog:",
        "typescript": "catalog:",
        "viem": "catalog:"
    },
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "require": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist/**"
    ],
    "scripts": {
        "build": "run-s compile",
        "compile": "tsdown",
        "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
        "dev": "tsdown --watch",
        "lint": "biome check"
    },
    "publishConfig": {
        "access": "public"
    }
}
